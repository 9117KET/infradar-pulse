# === Vite (browser) — copy to `.env` ===
# Lovable Cloud autopopulates these; only edit when deploying outside Lovable.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# DORMANT — Paddle (kept for reference/rollback; not called from any client
# path). Leave unset. See CLAUDE.md for why Lemon Squeezy replaced it as the
# active processor.
# VITE_PAYMENTS_CLIENT_TOKEN=

# Master switch for live billing. Leave unset/"false" pre-launch: Upgrade CTAs
# then open the founding-access modal (demand capture) instead of a real
# checkout. Set to "true" only once billing is ready to charge. Also doubles
# as the sandbox/live discriminator for Lemon Squeezy (one store, no separate
# sandbox/live account pair) — see src/lib/billing/environment.ts.
VITE_PAYMENTS_LIVE=false

# Lemon Squeezy store ID (Settings → General in the LS dashboard).
VITE_LEMONSQUEEZY_STORE_ID=

# === Supabase Edge Function secrets (Dashboard → Edge Functions → Secrets) ===
#
# DORMANT — Paddle (kept for reference/rollback). Leave unset.
# PADDLE_SANDBOX_API_KEY=
# PADDLE_LIVE_API_KEY=
# PAYMENTS_SANDBOX_WEBHOOK_SECRET=
# PAYMENTS_LIVE_WEBHOOK_SECRET=
LOVABLE_API_KEY=
#
# Lemon Squeezy — active payment processor. See supabase/functions/_shared/
# lemonsqueezy.ts and lemonsqueezyPlans.ts. Variant IDs come from the
# Products → Variants pages in the LS dashboard after creating each plan.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_STARTER_MONTHLY=
LEMONSQUEEZY_VARIANT_STARTER_YEARLY=
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=
LEMONSQUEEZY_VARIANT_PRO_YEARLY=
LEMONSQUEEZY_VARIANT_LIFETIME_PRO_ONETIME=
#
# AI / research (managed by connectors where possible)
PERPLEXITY_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
FIRECRAWL_API_KEY=
#
# Default Supabase secrets (set by platform)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_PUBLISHABLE_KEY=
#
# Optional fallback for redirect URLs when Origin header missing
SITE_URL=http://localhost:5173
#
# Public "Ask AI" demo (nl-search-public) anti-abuse. Both optional but
# RECOMMENDED in production — without a strong DEMO_COOKIE_SECRET the signed
# visitor token can be forged, weakening the per-token rate limit (per-IP still
# applies). Each should be a long random string; both fall back to a public
# default if unset. DEMO_COOKIE_SECRET signs the visitor token; DEMO_IP_SALT
# salts the hashed-IP key (and is the fallback secret for the token).
# DEMO_COOKIE_SECRET=
# DEMO_IP_SALT=
#
# === Tests ===
# JWT gate tests: use raw tokens OR password sign-in (staff user needs user_roles.role = admin|researcher).
# Run: npm run sb:seed-security-test-users — prints / uses default emails + passwords.
# SECURITY_TEST_ACCESS_TOKEN=
# SECURITY_TEST_ACCESS_TOKEN_STAFF=
# SECURITY_TEST_USER_EMAIL=
# SECURITY_TEST_USER_PASSWORD=
# SECURITY_TEST_STAFF_EMAIL=
# SECURITY_TEST_STAFF_PASSWORD=
